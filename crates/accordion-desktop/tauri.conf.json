{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accordion",
  "mainBinaryName": "Accordion",
  "identifier": "io.github.accordion-suite.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Accordion",
    "copyright": "AGPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Keeps your Drive files in sync with your own Accordion server",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
